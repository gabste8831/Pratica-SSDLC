# Modelo de configuração — RF-021.
# Copie para .env e preencha. O arquivo .env não é versionado (RS-015).

# Obrigatório: segredo de assinatura HS256, mínimo de 32 caracteres (RS-002).
# Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcionais — os valores abaixo são os padrões da aplicação.
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/securetasks.db
LOG_LEVEL=info
